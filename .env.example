# Copy to `.env` (git-ignored). Compose reads it automatically; everything is optional.

# Host ports
APP_PORT=8080
DB_PORT=5432

# Passed through to the app container (APP_* -> app/settings.py)
APP_LOG_LEVEL=DEBUG
# Websites allowed to call the API from a browser (comma-separated origins)
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
